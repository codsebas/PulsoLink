# PulsoLink API - desarrollo local conectado a Firebase real.
# Copiar a apps/api/.env. Completar los campos vacios; no publicar valores reales.
# Las claves estan activas. Los campos alternativos vacios no habilitan otro modo.
# Guia: docs/setup/hosting-y-pruebas-externas.md

PORT=3001
NODE_ENV=development
# Debe coincidir con la URL abierta en el navegador, incluido el puerto.
# Si Vite inicia en 5174, cambiar este valor a http://localhost:5174.
CORS_ORIGIN=http://localhost:5173
# Valor exclusivo de desarrollo; production lo rechaza. Generar uno propio al desplegar.
CSRF_SECRET=pulsolink-dev-csrf-secret-key-32chars-min
COOKIE_SECURE=false
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ID publico del proyecto de pruebas del equipo. No es una credencial.
FIREBASE_PROJECT_ID=pulsolink-pruebas-2026-7c8a31
# Obligatoria para login funcional. Copiar la clave web del MISMO proyecto Firebase.
FIREBASE_WEB_API_KEY=

# Elegir UNA forma de credencial Admin:
# Local: completar GOOGLE_APPLICATION_CREDENTIALS con ruta absoluta al JSON privado.
# Ejemplo de formato: C:/Users/TU_USUARIO/AppData/Local/PulsoLink/serviceAccountKey.json
# En Google Cloud con identidad de servicio/ADC, dejar los tres campos vacios.
# En otro hosting se puede montar el JSON o completar EMAIL y PRIVATE_KEY.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
# Si se usa esta alternativa, poner el PEM entre comillas con saltos literales \n.
FIREBASE_PRIVATE_KEY=

# CLOUD: dejar AMBOS vacios. EMULADORES: cambiar FIREBASE_PROJECT_ID a demo-pulsolink
# y completar AMBOS con los hosts/puertos de firebase/emulators.test.json.
# Puertos de ese archivo: Firestore 127.0.0.1:18080; Auth 127.0.0.1:19099.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# SOLO scripts manuales de aprovisionamiento; el servidor no los ejecuta.
# Se dejan vacios para impedir altas accidentales al copiar la plantilla.
# Identidades: provision-auth-users.ts, luego perfiles: provision-demo.ts.
# PROVISION_TARGET_PROJECT debe coincidir con FIREBASE_PROJECT_ID.
# Conservar contrasenas en un medio privado; suministrarlas por entorno al ejecutar.
PROVISION_TARGET_PROJECT=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
PROVISION_ADMIN_NAME=
PROVISION_VIEWER_EMAIL=
PROVISION_VIEWER_PASSWORD=
PROVISION_VIEWER_NAME=
# No usar el alias legado PROVISION_OPERATOR_* para configuraciones nuevas.

# Perfiles demo: JSON de UID reales generado por el primer script, roles admin/viewer.
DEMO_PROFILES_JSON=[]
DEMO_DEVICE_ID=
DEMO_CREDENTIAL_ID=
DEMO_DEVICE_SECRET=
# Solo seed de emuladores desechables: minimo 12 caracteres, sin datos reales.
DEMO_FIXTURE_PASSWORD=

# Placa real: provision-physical-device.ts. Guia: docs/setup/placa-fisica-aprovisionamiento.md
# Actor: UID de un admin habilitado, no su correo. APPLY=false mantiene dry-run.
PROVISION_ACTOR_UID=
PROVISION_APPLY=false
PHYSICAL_DEVICE_ID=
PHYSICAL_DEVICE_CODE=
PHYSICAL_HARDWARE_ID=
# Vacio usa la carpeta privada predeterminada fuera del repositorio.
PHYSICAL_DEVICE_CONFIG_FILE=
# PulsoAI: solo backend. Mantener false hasta configurar y validar Groq.
SESSION_SUMMARY_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
