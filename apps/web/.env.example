# PulsoLink Web - desarrollo local. Copiar a apps/web/.env.
# Todas las variables VITE_* son publicas; no colocar claves privadas ni secretos.
# Backend local. Si cambia el puerto de Express, ajustar el destino.
VITE_API_PROXY_TARGET=http://localhost:3001

# Ruta relativa: navegador -> Vite -> Express. Mantener mismo origen para cookies/CSRF.
# CORS_ORIGIN de la API debe ser el origen de Vite, por ejemplo http://localhost:5173.
VITE_API_BASE_URL=/api/v1
