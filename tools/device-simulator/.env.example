# ==============================================================================
# PulsoLink Device Simulator — Variables de Entorno de Ejemplo
# ==============================================================================
# URL base de la API de backend (Contrato A)
API_BASE_URL=http://localhost:3001/api/v1

# Credencial del dispositivo simulado (formato: <credentialId>.<secret>)
DEVICE_CREDENTIAL_ID=cred-sim-001
DEVICE_SECRET=sec_local_simulator_secret_token

# ID del dispositivo asociado
DEVICE_ID=dev-sim-001

# Intervalo de reporte en milisegundos (predeterminado: 2000 ms)
UPLOAD_INTERVAL_MS=2000
