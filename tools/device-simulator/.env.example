# PulsoLink - simulador oficial. Copiar a tools/device-simulator/.env.
# LAN: URL de Express. Externo: https://TU_HOST/api/v1, sin /device al final.
API_BASE_URL=http://localhost:3001/api/v1

# Credencial EXCLUSIVA del dispositivo simulado; nunca una cuenta Firebase Admin.
# Completar con IDs y secreto del aprovisionamiento. Los marcadores no autentican.
DEVICE_CREDENTIAL_ID=REPLACE_WITH_TEST_CREDENTIAL_ID
DEVICE_SECRET=REPLACE_WITH_TEST_SECRET
DEVICE_ID=REPLACE_WITH_REGISTERED_SIMULATED_DEVICE

# normal | no_contact | unavailable | invalid | random_disconnect
SIMULATOR_MODE=normal
SIMULATOR_SEED=42
REQUEST_TIMEOUT_MS=5000
CONFIG_INTERVAL_MS=2000
RECONNECT_INTERVAL_MS=2000
DISCONNECT_EVERY_MS=60000
DISCONNECT_DURATION_MS=50000

# Solo npm run qa; no afectan al emisor normal.
# Habilitar escrituras explicitamente SOLO en un entorno de pruebas preparado.
QA_ALLOW_WRITES=false
# Origen de navegador permitido por CORS_ORIGIN en la API; para externo, HTTPS real.
QA_ORIGIN=http://localhost:5173
QA_ADMIN_EMAIL=
QA_VIEWER_EMAIL=
# El ejecutor actual espera la misma contrasena de fixture para ambas cuentas.
QA_PASSWORD=
QA_JOINT_DEVICE_SECRET=
QA_PATIENT_A=demo-patient-a
QA_PATIENT_B=demo-patient-b
QA_PERMISSIONS=true
QA_ENVIRONMENT=local
# Vacio imprime el resultado sin escribir un archivo; si se completa, crear antes su carpeta.
QA_REPORT=
# QA_SESSION_ID es un override opcional: no definirlo para descubrir la sesion por config.
# Las credenciales/cuentas de QA requieren fixtures especificos; no apuntar a datos compartidos.
