# ==============================================================================
# PulsoLink API — Variables de Entorno de Ejemplo
# ==============================================================================
# Copie este archivo como .env para el entorno local.
# NO guarde credenciales reales ni claves privadas en este archivo.

# Puerto del servidor Express (predeterminado: 3001)
PORT=3001

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Origen permitido para CORS (dirección de la aplicación web)
CORS_ORIGIN=http://localhost:5173

# Secreto para firma y verificación de tokens CSRF en desarrollo local
CSRF_SECRET=pulsolink-local-dev-csrf-secret-replace-in-production

# ------------------------------------------------------------------------------
# Configuración de Firebase Admin SDK (Cloud Firestore y Authentication)
# ------------------------------------------------------------------------------
# El servidor puede arrancar inicialmente sin credenciales para health checks.
# Al conectar con Firebase en desarrollo local, defina las siguientes variables
# o proporcione la ruta a su clave de cuenta de servicio (serviceAccountKey.json):

FIREBASE_PROJECT_ID=pulsolink-dev
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@pulsolink-dev.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"

# Alternativa estándar: ruta a la cuenta de servicio local (mantener fuera de git):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Para emuladores locales de Firebase (si aplica en desarrollo):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------------------
# Autenticación web (Contrato B — Issue #10)
# ------------------------------------------------------------------------------
# Clave web del proyecto (Firebase Console → Configuración → Clave de API web).
# Es OPCIONAL en el arranque: sin ella la API inicia igualmente (health checks)
# y POST /api/v1/auth/login responde 503 AUTH_UNAVAILABLE.
# FIREBASE_WEB_API_KEY=AIza...

# Origen(es) permitido(s) para el navegador, separados por coma. Reemplaza a
# CORS_ORIGIN para la validación de Origin/Referer del CSRF.
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Atributo Secure de las cookies de sesión y CSRF. true por defecto en producción.
# En desarrollo local por HTTP (sin TLS) defínalo en false o el navegador
# descartará las cookies.
COOKIE_SECURE=false

# Duración de la sesión en horas (predeterminado: 8)
# SESSION_TTL_HOURS=8

# Límite de intentos de login por IP (predeterminados: 10 intentos / 15 minutos)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Aprovisionamiento de perfiles vinculados a identidades Auth YA existentes.
# Orden: (1) npx tsx src/scripts/provision-auth-users.ts  → crea identidades y
#        imprime DEMO_PROFILES_JSON; (2) npx tsx src/scripts/provision-demo.ts
#        → crea users/{uid} y el dispositivo. Ver docs/auth.md.
# Identidades Auth (provision-auth-users.ts):
# FIREBASE_PROJECT_ID=pulsolink-dev
# PROVISION_TARGET_PROJECT=pulsolink-dev
# PROVISION_ADMIN_EMAIL=admin@pulselink.test
# PROVISION_ADMIN_PASSWORD=<mínimo 10 caracteres; solo para Authentication>
# PROVISION_ADMIN_NAME=Admin demo
# PROVISION_VIEWER_EMAIL=consulta@pulselink.test
# PROVISION_VIEWER_PASSWORD=<mínimo 10 caracteres; solo para Authentication>
# PROVISION_VIEWER_NAME=Consulta demo
# PROVISION_OPERATOR_* es alias legado de VIEWER; no combinar valores distintos.
# Repetir preserva contraseñas/nombres y rechaza identidades deshabilitadas.
# Perfiles + dispositivo (provision-demo.ts):
# DEMO_PROFILES_JSON=[{"uid":"UID_DEL_VIEWER","displayName":"Consulta demo","role":"viewer"},{"uid":"UID_DEL_ADMIN","displayName":"Admin demo","role":"admin"}]
# DEMO_DEVICE_ID=sim-001
# DEMO_CREDENTIAL_ID=sim-001-credential
# DEMO_DEVICE_SECRET=<32 bytes aleatorios codificados como base64url; solo en .env>
