# PulsoLink API - referencia para variables del hosting HTTPS.
# En el proveedor, configurar las variables en su panel/gestor de secretos.
# Para ejecucion manual: copiar a .env en el directorio de trabajo de la API.
# El modo production NO carga automaticamente un archivo .env.production.
# No copiar valores privados al repositorio. Completar campos requeridos antes de arrancar.

# Si el proveedor inyecta PORT, conservar su valor.
PORT=8080
NODE_ENV=production
# Reemplazar por el origen HTTPS real que sirve la web, sin /api/v1.
CORS_ORIGIN=https://pulsolink.example.com
# OBLIGATORIO: generar un secreto aleatorio propio de al menos 32 caracteres.
CSRF_SECRET=
COOKIE_SECURE=true
SESSION_TTL_HOURS=8
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

FIREBASE_PROJECT_ID=pulsolink-pruebas-2026-7c8a31
# Clave web de Authentication del mismo proyecto, necesaria para login.
FIREBASE_WEB_API_KEY=

# Cloud Run: identidad de servicio con permisos minimos + ADC; dejar estos campos vacios.
# Render/Railway: elegir JSON montado por el proveedor O EMAIL + PRIVATE_KEY.
# Nunca reutilizar una ruta C:/... de la computadora local en el servidor Linux.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CLIENT_EMAIL=
# PEM entre comillas con saltos literales \n si se usa esta alternativa.
FIREBASE_PRIVATE_KEY=

# Deben permanecer vacios para Firebase real. No configurar hosts de emulador en hosting.
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
# PulsoAI: configurar clave privada en Environment de Render, nunca en Git.
SESSION_SUMMARY_ENABLED=false
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
