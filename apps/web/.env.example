# ==============================================================================
# PulsoLink Frontend Web — Variables de Entorno de Ejemplo
# ==============================================================================
# IMPORTANTE: NO incluya secretos ni credenciales privadas en variables VITE_*.
# El código cliente del frontend es público e inspeccionable en el navegador.

# Destino del proxy local de Vite hacia la API de backend (predeterminado: http://localhost:3001)
VITE_API_PROXY_TARGET=http://localhost:3001

# Prefijo base de la API. En desarrollo local se utiliza el proxy relativo '/api/v1'.
# En producción puede configurarse con el dominio público del backend:
VITE_API_BASE_URL=/api/v1
